# =============================================================================
# AGRILION — Variables de Entorno del Backend IoT
# =============================================================================
# Copiar este archivo como .env y completar con tus credenciales reales.
#
#   cp .env.example .env
#
# Guía de dónde sale cada valor: ../docs/CREDENCIALES.md
#
# ⚠️  NUNCA subas el archivo .env a git (ya está en .gitignore)
# =============================================================================

# ─── TTN (The Things Network) ────────────────────────────────────────────────
# TTN Console → Application → End devices → General settings
#   TTN_USER   = "{application_id}@ttn"
#   TTN_PASS   = API key con permiso de tráfico (Read application traffic)
#   TTN_APP_ID = application_id SIN "@ttn" (se usa en el topic v3/{app_id}/...)
TTN_BROKER=eu1.cloud.thethings.network
TTN_PORT=8883
TTN_USER=tu_app_id@ttn
TTN_PASS=tu_api_key_de_ttn
TTN_APP_ID=tu_app_id

# ─── HiveMQ (broker intermediario) ───────────────────────────────────────────
HIVEMQ_BROKER=tu-cluster-id.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USER=tu_usuario_hivemq
HIVEMQ_PASS=tu_password_hivemq

# ─── InfluxDB 3 Core ─────────────────────────────────────────────────────────
# Local (Docker): http://localhost:8181  →  docker compose up -d influxdb
# Cloud: URL de tu instancia InfluxDB 3
INFLUX_URL=http://localhost:8181
INFLUX_HOST=http://localhost:8181
INFLUX_TOKEN=tu_token_de_influx
INFLUX_ORG=agrilion
INFLUX_BUCKET=silobolsas
INFLUX_DATABASE=silobolsas

# ─── Firebase Admin (datos categóricos) ──────────────────────────────────────
# serviceAccountKey.json descargado desde Firebase Console
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json

# ─── AI API (nuestro servidor de Python) ────────────────────────────────────
# URL donde corre la FastAPI de Inteligencia_Artificial
AI_API_URL=http://localhost:8000/api/v1
AI_API_TIMEOUT=10

# ─── Fallback de pruebas (opcional) ──────────────────────────────────────────
# Si un device no está registrado en Firestore, se usa este silo
# en vez de descartar la lectura.
DEFAULT_SILO_ID=SB-TEST01
DEFAULT_GRAIN=soja
