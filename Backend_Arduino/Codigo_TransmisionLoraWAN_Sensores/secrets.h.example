#ifndef AGRILION_SECRETS_H
#define AGRILION_SECRETS_H

// ============================================================
// AGRILION — Credenciales LoRaWAN (OTAA)
// ============================================================
// Este archivo es PRIVADO y está ignorado por git.
//
// Cómo obtener los valores:
//   TTN Console → Application → End device → General settings
//     - DevEUI   (identidad de hardware del CubeCell)
//     - JoinEUI  (antes AppEUI; identifica la aplicación/join server)
//     - AppKey   (clave de sesión OTAA — rotable)
//
// Luego de cambiar el AppKey en TTN hay que reflashear el equipo
// y resetear la sesión (Ver "Rotación de credenciales" en README.md).
// ============================================================

uint8_t devEui[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
uint8_t appEui[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
uint8_t appKey[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

#endif
